        "procedure LzmaMyDecoderInit(var vs: TLZMAInternalDecoderState;",
        "function LzmaDecode(var vs: TLZMAInternalDecoderState;",
        "TLZMADecompressorCallbackData = record",
        "Instance: TLZMA1SmallDecompressor;",
